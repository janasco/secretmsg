# SecretMsg Public Client Environment Configuration
# Copy this file to apps/web/.env to customize your local development settings

# Edge API Base URL
# In development, defaults to production API or your local private worker
VITE_API_URL="https://api.secretmsg.net"

# Public Web Portal Base URL (landing, public messages, templates)
VITE_PUBLIC_URL="https://secretmsg.net"

# Account Management Portal URL (inbox, profile, settings, replies)
VITE_ACCOUNT_APP_URL="https://app.secretmsg.net"
VITE_APP_URL="https://app.secretmsg.net"

# Cloudflare Turnstile Public Site Key (Safe to commit / public)
# Testing Key: 1x00000000000000000000AA (always passes)
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Open-Source Contributor Mock Mode:
# Set to 'true' to develop entirely offline using local mock data (no API required!)
VITE_USE_MOCK="false"

# Polar.sh Issue Funding & Supporter URL
VITE_DONATION_URL="https://polar.sh/janasco/secretmsg"
